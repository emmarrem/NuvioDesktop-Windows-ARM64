@@ -0,0 +1,45 @@
+package com.nuvio.app.features.updater
+
+private val arm64Tag = Regex("^([a-zA-Z0-9][a-zA-Z0-9.+-]*)-arm64\\.([1-9][0-9]*)$")
+private const val releaseRoot = "https://github.com/emmarrem/NuvioDesktop-Windows-ARM64/releases"
+
+private data class PortableArm64Version(
+    val upstream: SemanticVersion,
+    val revision: Long,
+) : Comparable<PortableArm64Version> {
+    override fun compareTo(other: PortableArm64Version): Int =
+        upstream.compareTo(other.upstream).takeIf { it != 0 } ?: revision.compareTo(other.revision)
+}
+
+private fun parsePortableArm64Version(tag: String): PortableArm64Version? {
+    val (upstream, revision) = arm64Tag.matchEntire(tag)?.destructured ?: return null
+    return PortableArm64Version(VersionUtils.parse(upstream) ?: return null, revision.toLongOrNull() ?: return null)
+}
+
+internal fun isPortableArm64UpdateNewer(remote: String, installed: String): Boolean {
+    val candidate = parsePortableArm64Version(remote) ?: return false
+    val current = parsePortableArm64Version(installed) ?: return false
+    return candidate > current
+}
+
+internal fun selectPortableArm64Update(releases: List<GitHubReleaseDto>): AppUpdate? =
+    releases.asSequence()
+        .filterNot { it.draft || it.prerelease }
+        .mapNotNull { release ->
+            val tag = release.tagName ?: return@mapNotNull null
+            val version = parsePortableArm64Version(tag) ?: return@mapNotNull null
+            val upstreamTag = tag.substringBeforeLast("-arm64.")
+            val asset = release.assets.singleOrNull {
+                it.name == "Nuvio-Windows-arm64-${upstreamTag.removePrefix("v")}.msi" &&
+                    it.browserDownloadUrl == "$releaseRoot/download/$tag/${it.name}"
+            } ?: return@mapNotNull null
+            version to AppUpdate(
+                tag = tag,
+                title = release.name?.takeIf(String::isNotBlank) ?: tag,
+                notes = release.body.orEmpty(),
+                releaseUrl = "$releaseRoot/tag/$tag",
+                assetName = asset.name,
+                assetUrl = asset.browserDownloadUrl,
+                assetSizeBytes = asset.size,
+            )
+        }.maxByOrNull { it.first }?.second
