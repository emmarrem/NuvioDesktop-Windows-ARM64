+package com.nuvio.app.features.updater
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class WindowsArm64UpdatesTest {
+    @Test
+    fun comparesUpstreamVersionThenArm64Revision() {
+        assertTrue(isPortableArm64UpdateNewer("0.1.36-alpha-arm64.2", "0.1.36-alpha-arm64.1"))
+        assertTrue(isPortableArm64UpdateNewer("0.1.37-alpha-arm64.1", "0.1.36-alpha-arm64.2"))
+        assertTrue(isPortableArm64UpdateNewer("0.1.36-arm64.1", "0.1.36-alpha-arm64.2"))
+        assertFalse(isPortableArm64UpdateNewer("0.1.36-alpha-arm64.2", "0.1.36-alpha-arm64.2"))
+        assertFalse(isPortableArm64UpdateNewer("0.1.35-alpha-arm64.9", "0.1.36-alpha-arm64.2"))
+    }
+
+    @Test
+    fun skipsDraftsPrereleasesAndIncompatibleDownloads() {
+        val revisionTwo = "0.1.36-alpha-arm64.2"
+        val valid = release(revisionTwo, "Nuvio-Windows-arm64-0.1.36-alpha.msi")
+        val releases = listOf(
+            release("0.1.37-alpha-arm64.1", "Nuvio-Windows-x64-0.1.37-alpha.msi"),
+            release("0.1.36-alpha-arm64.1", "Nuvio-Windows-arm64-0.1.36-alpha-portable.zip"),
+            release("0.1.38-alpha-arm64.1", "Nuvio-Windows-arm64-0.1.38-alpha.msi").copy(draft = true),
+            release("0.1.39-alpha-arm64.1", "Nuvio-Windows-arm64-0.1.39-alpha.msi").copy(prerelease = true),
+            valid,
+        )
+        val selected = selectPortableArm64Update(releases)
+        assertEquals(revisionTwo, selected?.tag)
+        assertEquals(valid.assets.single().browserDownloadUrl, selected?.assetUrl)
+    }
+
+    private fun release(tag: String, asset: String) = GitHubReleaseDto(
+        tagName = tag,
+        assets = listOf(GitHubAssetDto(asset, "https://github.com/emmarrem/NuvioDesktop-Windows-ARM64/releases/download/$tag/$asset")),
+    )
+}
